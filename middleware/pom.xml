<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tn.medimage</groupId>
  <artifactId>medimage-middleware</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MedImage-Trust :: middleware (parent)</name>

  <!--
    Trois modules seulement (décision d'architecture) :
    core (jar, commun aux deux WAR), api (war, tout le code développé), iam (war, authentification à venir).
  -->
  <modules>
    <module>core</module>
    <module>api</module>
    <module>iam</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.5.1</archunit.version>
    <!--
      dcm4che : 5.35.2, dernière version résolvable du dépôt officiel au 28/11/2026. La 5.36.0 y est publiée, mais
      son POM parent (dcm4che-parent 5.36.0) est absent du dépôt (404) : Maven ne peut pas la résoudre.
    -->
    <dcm4che.version>5.35.2</dcm4che.version>
    <!-- Version imposée par dcm4che-parent 5.35.2 ; fournie par WildFly à l'exécution (module org.slf4j). -->
    <slf4j.version>2.0.18</slf4j.version>
  </properties>

  <!--
    dcm4che n'est pas publié sur Maven Central : dépôt officiel en HTTPS, versions publiées seulement. Ce dépôt ne
    peut servir que le groupe org.dcm4che (filtre du resolver : .mvn/maven.config et .mvn/rrf/groupId-dcm4che.txt) ;
    sommes de contrôle strictes comme pour Central (option strict-checksums de maven.config, checksumPolicy fail).
  -->
  <repositories>
    <repository>
      <id>dcm4che</id>
      <name>dcm4che (dépôt officiel)</name>
      <url>https://www.dcm4che.org/maven2/</url>
      <releases>
        <enabled>true</enabled>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.dcm4che</groupId>
        <artifactId>dcm4che-core</artifactId>
        <version>${dcm4che.version}</version>
        <exclusions>
          <!-- slf4j-api est fourni par WildFly : déclaré à part, en provided, pour ne pas l'embarquer dans le WAR. -->
          <exclusion>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>tn.medimage</groupId>
        <artifactId>medimage-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-api</artifactId>
        <version>11.0.0</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <!--
            Les bancs se lancent dans le réacteur, sans installation : « -pl api -am … exec:java@attack-bench ».
            Maven exécute alors exec:java dans chaque module du réacteur (parent, core, api) : il est sauté partout
            par défaut, et seul api le réactive (skip=false). mainClass factice : Maven exige ce paramètre obligatoire
            avant même que le plugin ne teste skip.
          -->
          <configuration>
            <skip>true</skip>
            <mainClass>none</mainClass>
          </configuration>
        </plugin>
        <!--
          SBOM CycloneDX (job sbom de ci.yml) : version épinglée ici, appel par le préfixe court
          « mvn -B -f middleware/pom.xml cyclonedx:makeAggregateBom ». Lié à aucune phase : verify ne le lance pas.
        -->
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
